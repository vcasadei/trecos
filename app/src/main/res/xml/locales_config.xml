<?xml version="1.0" encoding="utf-8"?>
<!-- Languages offered in Android 13+'s per-app language setting. Portuguese
     strings live in values-pt so every Portuguese phone (pt-PT too) gets them. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="pt-BR" />
</locale-config>
